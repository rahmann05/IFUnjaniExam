<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvQuestionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pertanyaan"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#2c3e50" />

        <ImageView
            android:id="@+id/ivQuestionImage"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="8dp"
            android:scaleType="centerInside"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/llStudentAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="#ecf0f1">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jawaban Mahasiswa:"
                android:textSize="12sp"
                android:textColor="#7f8c8d" />

            <TextView
                android:id="@+id/tvStudentAnswer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jawaban"
                android:textSize="14sp"
                android:layout_marginTop="4dp"
                android:textStyle="bold" />
                
            <TextView
                android:id="@+id/tvCorrectAnswerLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Seharusnya:"
                android:textSize="12sp"
                android:textColor="#e74c3c"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvCorrectAnswer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jawaban Benar"
                android:textSize="14sp"
                android:textColor="#e74c3c"
                android:textStyle="italic"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="BENAR (+10 Poin)"
            android:textAlignment="viewEnd"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#27ae60" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
