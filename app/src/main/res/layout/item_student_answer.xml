<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvQuestionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pertanyaan"
            android:textSize="16sp"
            android:textStyle="bold"
            android:lineSpacingExtra="4dp"
            android:textColor="#1E293B" />

        <ImageView
            android:id="@+id/ivQuestionImage"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="12dp"
            android:scaleType="centerInside"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#F8FAFC"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:id="@+id/llStudentAnswer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="JAWABAN MAHASISWA"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#64748B"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/tvStudentAnswer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jawaban"
                    android:textSize="15sp"
                    android:layout_marginTop="4dp"
                    android:textColor="#0F172A"
                    android:textStyle="normal" />
                    
                <TextView
                    android:id="@+id/tvCorrectAnswerLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SEHARUSNYA"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#EF4444"
                    android:letterSpacing="0.05"
                    android:layout_marginTop="16dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvCorrectAnswer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jawaban Benar"
                    android:textSize="15sp"
                    android:textColor="#DC2626"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="BENAR (+10 Poin)"
            android:textAlignment="viewEnd"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#10B981" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
